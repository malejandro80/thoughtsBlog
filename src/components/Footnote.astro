---
interface Props {
  text?: string;
}

const defaultText=`La intención principal de este post es pensar y hacer pensar, independientemente del sentimiento que pueda suscitar. Si así ha sido el caso me doy por bien servido y como dice el meme: "Mi trabajo aquí ha terminado"`

const { text = defaultText } = Astro.props;
---

<aside class="footnote">
  <p>{text}</p>
</aside>

<style>
  .footnote {
    margin-top: 2rem;
    padding: 1rem 1.25rem;
    background: var(--surface-muted);
    border-left: 3px solid var(--accent-primary);
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
    color: var(--muted);
  }
  .footnote p {
    margin: 0;
  }
</style>
