---
import { SITE } from '../consts';
import { useTranslations } from '../utils/locale';

const locale = Astro.currentLocale ?? 'es';
const t = useTranslations(locale);
---

<section class="profile-hero">
  <div class="profile-avatar">
    <img src="/profile.jpeg" alt="" width="112" height="112" loading="eager" />
  </div>
  <div class="profile-info">
    <h1>{SITE.author}</h1>
    <p>{SITE.locales[locale as 'es' | 'en']?.description ?? SITE.description}</p>
  </div>
</section>
