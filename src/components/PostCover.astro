---
interface Props {
  title: string;
  image?: string;
}

const { title, image } = Astro.props;
---

{
  image ? (
    <img class="post-cover" src={image} alt="" width="640" height="360" loading="lazy" />
  ) : (
    <div class="post-cover cover-fallback" aria-hidden="true">
      <span>{title.charAt(0).toUpperCase()}</span>
    </div>
  )
}
