---
interface Props {
  label: string;
}

const { label } = Astro.props;
const path = Astro.url.pathname;
const locale = Astro.currentLocale ?? 'es';
const isHome = path === '/' || path === `/${locale}/`;
const isBlog = path.startsWith('/blog') || path.startsWith(`/${locale}/blog`);
---

<nav aria-label={label}>
  <a
    href="/"
    class:list={['nav-link', { 'is-active': isHome }]}
    aria-current={isHome ? 'page' : undefined}
  >
    {locale === 'en' ? 'Home' : 'Inicio'}
  </a>
  <a
    href="/blog/"
    class:list={['nav-link', { 'is-active': isBlog }]}
    aria-current={isBlog ? 'page' : undefined}
  >
    Blog
  </a>
  <a class="nav-link portfolio-link" href="https://miguelintech.com/">{locale === 'en' ? 'Portfolio' : 'Portafolio'}</a>
</nav>

<script is:inline>
  (function () {
    var links = document.querySelectorAll('.portfolio-link');
    var handler = function () {
      window.gtag = window.gtag || function(){(window.dataLayer = window.dataLayer || []).push(arguments);};
      gtag('event', 'portfolio_click', { nav_label: 'portfolio' });
    };
    links.forEach(function (link) {
      if (link.dataset.gtmTracked) return;
      link.dataset.gtmTracked = '1';
      link.addEventListener('click', handler);
    });
  })();
</script>
