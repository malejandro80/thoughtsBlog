---
interface Props {
  label: string;
}

const { label } = Astro.props;
const path = Astro.url.pathname;
const locale = Astro.currentLocale ?? 'es';
const isHome = path === '/' || path === `/${locale}/`;
const isBlog = path.startsWith('/blog') || path.startsWith(`/${locale}/blog`);
---

<nav aria-label={label}>
  <a
    href="/"
    class:list={['nav-link', { 'is-active': isHome }]}
    aria-current={isHome ? 'page' : undefined}
  >
    {locale === 'en' ? 'Home' : 'Inicio'}
  </a>
  <a
    href="/blog/"
    class:list={['nav-link', { 'is-active': isBlog }]}
    aria-current={isBlog ? 'page' : undefined}
  >
    Blog
  </a>
  <a class="nav-link" href="https://miguelintech.com/">{locale === 'en' ? 'Portfolio' : 'Portafolio'}</a>
</nav>
