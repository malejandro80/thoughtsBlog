---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import ProfileHero from '../components/ProfileHero.astro';
import { SITE } from '../consts';
import { getFeaturedPosts } from '../utils/posts';

const posts = await getFeaturedPosts(3);
---

<BaseLayout title={`${SITE.author} · ${SITE.title}`} description={SITE.description}>
  <ProfileHero />

  <section aria-label="Posts destacados">
    <h2 class="featured-heading">Posts destacados</h2>
    {posts.map((post) => <PostCard post={post} />)}
  </section>

  <p><a href="/blog/">Ver todos los posts →</a></p>
</BaseLayout>
