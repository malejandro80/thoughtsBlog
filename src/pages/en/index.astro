---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import ProfileHero from '../../components/ProfileHero.astro';
import { SITE } from '../../consts';
import { getFeaturedPosts } from '../../utils/posts';
import { useTranslations } from '../../utils/locale';

const locale = Astro.currentLocale ?? 'en';
const t = useTranslations(locale);
const posts = await getFeaturedPosts(3, locale);
---

<BaseLayout title={`${SITE.author} · ${SITE.title}`} description={SITE.locales[locale as 'es' | 'en']?.description ?? SITE.description}>
  <ProfileHero />

  <section aria-label={t.home.featured}>
    <h2 class="featured-heading">{t.home.featured}</h2>
    <div class="post-list">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>

  <p class="section-cta">
    <a class="btn btn-primary" href="/en/blog/">{t.home.viewAll}</a>
  </p>
</BaseLayout>
