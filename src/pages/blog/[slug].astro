---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BackLink from '../../components/BackLink.astro';
import { SITE } from '../../consts';
import { getPublishedPosts } from '../../utils/posts';
import { formattedDate } from '../../utils/formattedDate';
import Footnote from '../../components/Footnote.astro';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
const canonical = new URL(`/blog/${post.id}/`, SITE.url);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: { '@type': 'Person', name: SITE.author },
  publisher: { '@type': 'Person', name: SITE.author },
  image: new URL(post.data.image ?? '/og-default.png', SITE.url).toString(),
  mainEntityOfPage: canonical.toString(),
  ...(post.data.tags.length > 0 && { keywords: post.data.tags.join(', ') }),
};
---

<BaseLayout
  title={`${post.data.title} · ${SITE.title}`}
  description={post.data.description}
  image={post.data.image}
  type="article"
  publishedTime={post.data.pubDate}
  modifiedTime={post.data.updatedDate}
  tags={post.data.tags}
  jsonLd={jsonLd}
>
  <article>
    <p class="section-cta-start">
      <BackLink href="/blog/" label="Todos los posts" />
    </p>
    {post.data.image && (
      <img class="article-cover" src={post.data.image} alt={post.data.title} width="640" height="360" loading="eager" />
    )}
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <time datetime={post.data.pubDate.toISOString()}>{formattedDate(post.data.pubDate)}</time>
      {post.data.updatedDate && (
        <p>
          Actualizado:
          <time datetime={post.data.updatedDate.toISOString()}>
            {formattedDate(post.data.updatedDate)}
          </time>
        </p>
      )}
      <ul class="tags">
        {post.data.tags.map((tag) => <li><span>#{tag}</span></li>)}
      </ul>
    </header>

    <div class="prose">
      <Content />
    </div>
    <Footnote text={post.data.footnote} />
  </article>
</BaseLayout>
