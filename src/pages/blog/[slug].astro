---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BackLink from '../../components/BackLink.astro';
import { SITE } from '../../consts';
import { getPublishedPosts, stripLocale } from '../../utils/posts';
import { formattedDate } from '../../utils/formattedDate';
import Footnote from '../../components/Footnote.astro';
import { useTranslations } from '../../utils/locale';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => {
    const locale = post.id.split('/')[0];
    const slug = stripLocale(post.id);
    return {
      params: { slug, locale },
      props: { post, locale },
    };
  });
}

interface Props {
  post: CollectionEntry<'blog'>;
  locale: string;
}

const { post, locale } = Astro.props;
const { Content } = await render(post);
const t = useTranslations(locale);
const slug = stripLocale(post.id);
const blogPath = locale === 'en' ? '/en/blog' : '/blog';
const canonical = new URL(`${blogPath}/${slug}/`, SITE.url);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: { '@type': 'Person', name: SITE.author },
  publisher: { '@type': 'Person', name: SITE.author },
  image: new URL(post.data.image ?? '/og-default.png', SITE.url).toString(),
  mainEntityOfPage: canonical.toString(),
  ...(post.data.tags.length > 0 && { keywords: post.data.tags.join(', ') }),
};
---

<BaseLayout
  title={`${post.data.title} · ${SITE.title}`}
  description={post.data.description}
  image={post.data.image}
  type="article"
  publishedTime={post.data.pubDate}
  modifiedTime={post.data.updatedDate}
  tags={post.data.tags}
  jsonLd={jsonLd}
>
  <article>
    <p class="section-cta-start">
      <BackLink href={`${blogPath}/`} label={t.back.blog} />
    </p>
    {post.data.image && (
      <img class="article-cover" src={post.data.image} alt={post.data.title} width="640" height="360" loading="eager" />
    )}
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <time datetime={post.data.pubDate.toISOString()}>{formattedDate(post.data.pubDate, locale)}</time>
      {post.data.updatedDate && (
        <p>
          {t.post.updated}
          <time datetime={post.data.updatedDate.toISOString()}>
            {formattedDate(post.data.updatedDate, locale)}
          </time>
        </p>
      )}
      <ul class="tags">
        {post.data.tags.map((tag) => <li><span>#{tag}</span></li>)}
      </ul>
    </header>

    <div class="prose">
      <Content />
    </div>
    <Footnote />
  </article>
</BaseLayout>
