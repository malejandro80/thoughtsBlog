---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../consts';
import { useTranslations } from '../utils/locale';
import '../styles/global.css';

interface Props {
  title: string;
  wide?: boolean;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  jsonLd?: Record<string, unknown>;
  analytics?: { event: string; data: Record<string, unknown> };
}

const {
  title,
  wide = false,
  description,
  image = '/og-default.png',
  type = 'website',
  publishedTime,
  modifiedTime,
  tags = [],
  jsonLd,
  analytics,
} = Astro.props;

const locale = Astro.currentLocale ?? 'es';
const t = useTranslations(locale);
const canonical = new URL(Astro.url.pathname, SITE.url);
const ogImage = new URL(image, SITE.url);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-XGW994MSKT"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-XGW994MSKT');
    </script>
    <script is:inline>
      (function () {
        var lightCSS = ':root{--bg:#f8fafc;--surface:#fff;--surface-muted:#f1f5f9;--text:#0f172a;--muted:#64748b;--accent-primary:#046bd2;--accent-secondary:#26b7cd;--accent-gradient:linear-gradient(135deg,var(--accent-primary),var(--accent-secondary));--border:#e2e8f0;--bg-primary:var(--bg);--text-primary:var(--text);--text-secondary:var(--text);--text-muted:var(--muted);--accent-color:var(--accent-primary);--gradient-glow:var(--accent-secondary);--logo:var(--accent-primary);--nav:var(--muted);--chrome-bg:rgba(255,255,255,0.85);--shadow-card:0 20px 40px -15px rgba(15,23,42,0.08);--shadow-hover:0 30px 60px -15px rgba(4,107,210,0.12)}';
        var darkCSS = ':root{--bg:#0f172a;--surface:#1e293b;--surface-muted:#334155;--text:#f1f5f9;--muted:#94a3b8;--accent-primary:#3b82f6;--accent-secondary:#22d3ee;--accent-gradient:linear-gradient(135deg,var(--accent-primary),var(--accent-secondary));--border:#334155;--bg-primary:var(--bg);--text-primary:var(--text);--text-secondary:var(--text);--text-muted:var(--muted);--accent-color:var(--accent-primary);--gradient-glow:var(--accent-secondary);--logo:var(--accent-primary);--nav:var(--muted);--chrome-bg:rgba(15,23,42,0.85);--shadow-card:0 20px 40px -15px rgba(0,0,0,0.3);--shadow-hover:0 30px 60px -15px rgba(59,130,246,0.2)}';

        var lightEl = document.createElement('style');
        lightEl.id = 'theme-light';
        lightEl.textContent = lightCSS;
        document.head.appendChild(lightEl);

        var darkEl = document.createElement('style');
        darkEl.id = 'theme-dark';
        darkEl.textContent = darkCSS;
        darkEl.disabled = true;
        document.head.appendChild(darkEl);

        var t = localStorage.getItem('theme')
          || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.dataset.theme = t;
        if (t === 'dark') { lightEl.disabled = true; darkEl.disabled = false; }
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.content = t === 'dark' ? '#0f172a' : '#f8fafc';
      })();
    </script>
    <meta name="theme-color" id="theme-color" content="#f8fafc" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@500;600;700&family=Outfit:wght@600;700;800;900&display=swap" rel="stylesheet" />

    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={locale === 'es' ? 'es_ES' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    {type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}
  </head>
  <body>

    <Header />
    <main class:list={['container', { 'container-wide': wide }]}>
      <slot />
    </main>
    <Footer />
    {analytics && (
      <script is:inline set:html={`
        window.dataLayer = window.dataLayer || [];
        window.gtag = window.gtag || function(){dataLayer.push(arguments);};
        gtag('event', '${analytics.event}', ${JSON.stringify(analytics.data).replace(/</g, '\\u003c')});
      `} />
    )}
  </body>
</html>
